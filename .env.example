# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# OPTIONAL: enables AI scoring and AI conversation replies.
# The key is read only by the Express server (server/aiService.ts), so it is
# never bundled into the browser JS. If unset, the app uses the local mock
# scoring engine and can run fully offline.
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Backend port. Defaults to 3001. In a production build (`npm run build &&
# npm start`) this is the single port for both the app and the API.
PORT=3001

# Only needed for `npm run dev` when the API runs on a non-default port, e.g.
# VITE_API_URL=http://localhost:4000/api. Production builds use a relative
# /api path automatically and do not need this.
# VITE_API_URL=http://localhost:3001/api

# Delete stored recordings older than this many days on server start and after
# each upload. The transcript/score stay in the database. Set to 0 to disable.
RECORDING_RETENTION_DAYS=30

# Local speech-to-text service (Whisper) used when the app is in Offline mode.
# See README "Offline mode" for how to start one. Not needed in Online mode.
WHISPER_URL=http://localhost:8080/inference
